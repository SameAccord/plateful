{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${version}",
	"name": "${mod_name}",
	"description": "${description}",
	"authors": [
		"${mod_author}"
	],
	"license": "${license}",
	"icon": "assets/${mod_id}/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.sameaccord.plateful.PlatefulFabric"
		],
		"client": [
			"com.sameaccord.plateful.PlatefulFabricClient"
		]
	},
	"mixins": [
		"${mod_id}.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${fabric_loader_version}",
		"fabric-api": ">=${fabric_version_min}",
		"minecraft": "~${minecraft_version}",
		"java": ">=${java_version}"
	}
}
